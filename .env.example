# NeuraX API (FastAPI)
NEURAX_API_HOST=127.0.0.1
NEURAX_API_PORT=8000
NEURAX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEURAX_UPLOAD_DIR=data/uploads
NEURAX_MAX_UPLOAD_MB=100

# Domain config remains in config.py (LM Studio URL, Chroma path, etc.)
# LM Studio default: http://localhost:1234/v1

# Cloud LLM (OpenAI-compatible endpoint, optional)
# NEURAX_CLOUD_API_URL=https://api.groq.com/openai/v1
# NEURAX_CLOUD_API_KEY=your-api-key
# NEURAX_CLOUD_MODEL=llama-3.3-70b-versatile
# NEURAX_CLOUD_MAX_TOKENS=1024
# NEURAX_CLOUD_TEMPERATURE=0.7
# NEURAX_CLOUD_TIMEOUT=60

# NVIDIA NIM embeddings (optional; never commit the real key)
# NEURAX_NIM_EMBEDDINGS_ENABLED=true
# NEURAX_NIM_API_KEY=your-nvidia-api-key
# NEURAX_NIM_EMBEDDING_API_URL=https://integrate.api.nvidia.com/v1/embeddings
# NEURAX_NIM_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# NEURAX_NIM_COLLECTION_NAME=neurax_nim_nemotron_3_embed_1b_v1
# NEURAX_NIM_EMBEDDING_TIMEOUT=60
